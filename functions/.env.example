# Variables d'environnement pour les Cloud Functions kris&her
# Copiez ce fichier vers .env et remplissez les valeurs réelles.

# ID de la base Firestore utilisée par l'application
# Valeur par défaut : ai-studio-android-remixkri-5e20fb90-aca8-4a6c-9427-e49c2f1a40ba
FIRESTORE_DATABASE_ID=ai-studio-android-remixkri-5e20fb90-aca8-4a6c-9427-e49c2f1a40ba

# Région de la base Firestore (ex: us-central1, europe-west1, asia-southeast1)
FIRESTORE_REGION=us-central1
